{
  "name": "domains-analyzer",
  "description": "Analyze domains: schemas, entities, health, relations",
  "version": "2.0.0",
  "author": "vscheglov",
  "license": "MIT",
  "main": "dist/index.js",
  "type": "commonjs",
  "bin": {
    "domna": "./dist/index.js"
  },
   "files": [
    "dist/",
    "USER_GUIDE.md",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "copy:html": "node -e \"require('fs').mkdirSync('dist/web',{recursive:true}); require('fs').copyFileSync('src/web/index.html','dist/web/index.html')\"",
    "copy:userguide": "node -e \"require('fs').mkdirSync('dist',{recursive:true}); require('fs').copyFileSync('USER_GUIDE.md','dist/USER_GUIDE.md')\"",
    "build:web": "node scripts/build-web.js && npm run copy:html && npm run copy:userguide",
    "build:web:prod": "cross-env NODE_ENV=production node scripts/build-web.js && npm run copy:html && npm run copy:userguide",
    "build:server": "tsc -p tsconfig.build.json --sourceMap false",
    "build": "npm run clean && npm run build:web:prod && npm run build:server",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx tests/**/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.20.0",
    "reactflow": "^11.11.4",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "zustand": "^4.5.2"
  }
}
