{
  "name": "domains-analyzer",
  "description": "Analyze domains: schemas, entities, health, relations",
  "version": "2.0.0",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build:web": "node scripts/build-web.js",
    "build:web:prod": "cross-env NODE_ENV=production node scripts/build-web.js",
    "build:server": "tsc -p tsconfig.json",
    "build": "npm run build:web && npm run build:server",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx tests/**/*.test.ts"
  },
  "dependencies": {
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.20.0",
    "reactflow": "^11.11.4",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "zustand": "^4.5.2"
  }
}
